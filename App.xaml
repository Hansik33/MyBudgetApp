<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MyBudgetApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyBudgetApp"
    xmlns:helpers="using:MyBudgetApp.Helpers">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <ResourceDictionary.ThemeDictionaries>
                
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="DashboardCardBackgroundAcrylic"
                              TintColor="#F2F3F5"
                              TintOpacity="0.55"
                              FallbackColor="#F2F3F5" />
                    <SolidColorBrush x:Key="DashboardCardBorderBrush" Color="#D0D2D5"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="DashboardCardBackgroundAcrylic"
                TintColor="#1E1E1E"
                TintOpacity="0.20"
                FallbackColor="#1E1E1E" />
                    <SolidColorBrush x:Key="DashboardCardBorderBrush" Color="#3A3A3A"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DashboardCardBackgroundAcrylic"
                   Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DashboardCardBorderBrush"
                   Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
                
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>